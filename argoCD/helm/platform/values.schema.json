{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceup.example.com/charts/platform/values.schema.json",
  "title": "SpaceUp Platform Chart Values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "imageRegistry": { "type": "string" },
        "observability": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "additionalProperties": true
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "path": { "type": "string" }
          },
          "additionalProperties": true
        },
        "serviceMesh": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "additionalProperties": true
        },
        "tracing": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "additionalProperties": true
        }
      }
    },

    "security": {
      "type": "object",
      "properties": {
        "enableTLS": { "type": "boolean" },
        "enforcePSP": { "type": "boolean" },
        "podSecurityStandard": { "type": "string", "enum": ["privileged", "baseline", "restricted"] },
        "mTLS": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },

    "secrets": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["azureKeyVault", "vault"] },
        "externalSecrets": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "refreshInterval": { "type": "string", "pattern": "^[0-9]+(s|m|h|d)$" }
          },
          "additionalProperties": true
        },
        "aws": {
          "type": "object",
          "properties": {
            "region": { "type": "string", "minLength": 2 },
            "secretManagerPath": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "vault": {
          "type": "object",
          "properties": {
            "server": { "type": "string" },
            "path": { "type": "string" },
            "role": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "required": ["provider"],
      "additionalProperties": true
    },

    "loki": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "promtail": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },

    "tracing": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "tempo": {
          "type": "object",
          "properties": { "endpoint": { "type": "string" } },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },

    "velero": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": true },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "retention": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "gatekeeper": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": true },
    "consul": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": true },
    "postgresql": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": true },

    "external-secrets": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": true },

    "networkPolicy": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": true },
    "podDisruptionBudgets": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": true },
    "resourceQuota": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": true }
  }
}
